{
  "manifest_version": 3,
  "name": "Vinted Relist Assistant",
  "version": "1.0.0",
  "description": "Clone your Vinted listings into a new listing form for manual review.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.vinted.co.uk/*",
    "https://*.vinted.net/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Vinted Relist Assistant",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "128": "icons/vinted_relist.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.co.uk/*"],
      "js": ["src/content-profile.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
